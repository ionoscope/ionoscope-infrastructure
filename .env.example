IONOSCOPE_HTTP_PORT=80

IONOSCOPE_DATA_IMAGE=ionoscope-data:latest
IONOSCOPE_API_IMAGE=ionoscope-api:latest
IONOSCOPE_ML_IMAGE=ionoscope-ml-service:latest

IONOSCOPE_LIVE_STATIONS=auto
IONOSCOPE_LIVE_SOURCES=giro,gfz,omni,noaa
IONOSCOPE_LIVE_INTERVAL_SECONDS=300
IONOSCOPE_DISCOVERY_INTERVAL_SECONDS=3600
IONOSCOPE_LIVE_RETRY_SECONDS=60
IONOSCOPE_LIVE_INITIAL_HOURS=192
IONOSCOPE_LIVE_OVERLAP_HOURS=3

IONOSCOPE_FORECAST_REFRESH_INTERVAL_SECONDS=300
IONOSCOPE_FORECAST_REFRESH_TIMEOUT_SECONDS=30
IONOSCOPE_FORECAST_STALE_AFTER_MINUTES=30
IONOSCOPE_FORECAST_EXPIRE_AFTER_MINUTES=120
IONOSCOPE_REQUEST_TIMEOUT_SECONDS=10

IONOSCOPE_INPUT_PROFILE=candidate-cs50-period-end-v1
# Absolute directory containing the frozen candidate model.joblib on the deployment host
# IONOSCOPE_SHADOW_CANDIDATE_DIR=/srv/ionoscope/candidate
